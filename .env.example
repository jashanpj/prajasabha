# Copy to .env and adjust if needed. .env is gitignored — never commit real
# values. Local dev values below match docker-compose.yml + the CI service
# container's credentials (postgres:postgres) so migrations/tests behave
# identically in both places. See CLAUDE.md invariant 6: production values
# for anything below never live in code — they come from Wrangler secrets /
# KV config instead.

# packages/db (participation DB, `public` schema). Superuser connection —
# used by drizzle-kit, the migrate script, and tests, which need to CREATE
# ROLE (anon/authenticated/service_role/app_role) and SET ROLE to exercise
# RLS.
DATABASE_URL=postgres://postgres:postgres@localhost:5432/prajasabha_dev

# packages/vault-db (identity vault, `vault` schema). Superuser connection —
# used by drizzle-kit, the migrate script, and tests. Same physical
# container as DATABASE_URL for local dev only; see docker-compose.yml's
# header comment for why this is not the prod isolation boundary.
VAULT_DATABASE_URL=postgres://postgres:postgres@localhost:5432/prajasabha_dev?options=-c%20search_path%3Dvault

# apps/web's runtime connection to packages/db (issue #20). Connects as
# app_role — a LOGIN role created by docker/postgres/init/01-schemas-and-roles.sql
# (dev-only password, not a real secret) with no direct table grants of its
# own, only membership in service_role
# (packages/db/migrations/0002_grant_app_role_service_role.sql). Postgres
# role membership inherits privileges automatically, so app_role's queries
# run under service_role's own RLS policies/grants — see apps/web/src/lib/db.ts.
APP_DATABASE_URL=postgres://app_role:app_role_dev_only@localhost:5432/prajasabha_dev

# apps/vault-svc's runtime connection to packages/vault-db (issue #20).
# Connects directly as vault_role (same LOGIN role docker-compose already
# provisions) — vault_role's own grants from
# packages/vault-db/migrations/0000 are exactly what it needs, no
# indirection required.
VAULT_SVC_DATABASE_URL=postgres://vault_role:vault_role_dev_only@localhost:5432/prajasabha_dev

# packages/shared config-driven constants (issue #17). Required —
# loadConfig() throws if any of these are unset, deliberately: CLAUDE.md
# invariant 6 forbids these values as a silent fallback inside
# packages/shared/src/config.ts itself ("no secrets, thresholds, or
# rate-limit values in code... assume hostile readers of this public
# repo"), so the PRD/HLD-adopted numbers live only here — a gitignored
# local file — and in Wrangler vars/secrets for deployed environments.
CONCERN_THRESHOLD_T2=100
QUORUM_PERCENT=20
PANEL_TERM_MONTHS=6

# A1 magic-link registration (issue #20). loadMagicLinkConfig/
# loadRateLimitConfig throw if any of these are unset — same "no silent
# fallback" posture as above. Numbers here are reasonable MVP defaults, not
# sourced from product law (no doc specifies concrete figures).
MAGIC_LINK_TTL_MINUTES=15
REGISTER_RATE_LIMIT_PER_EMAIL_PER_HOUR=5
REGISTER_RATE_LIMIT_PER_IP_PER_HOUR=20
VERIFY_RATE_LIMIT_PER_IP_PER_HOUR=30

# apps/vault-svc: AES-GCM-256 key (encrypts the email so it can still be
# read back to actually send mail) and a separate HMAC-SHA256 pepper
# (one-way, duplicate-email lookup only — never reused as the encryption
# key). Dev-only values below — deliberately low-entropy (repeated-byte
# fill, not randomly generated) so they can't be mistaken for a leaked
# real key by gitleaks or a human skimming this file, while still being
# valid 32-byte keys for local dev's AES-GCM/HMAC calls. Deployed
# environments use real random Wrangler secrets, rotated independently.
EMAIL_ENCRYPTION_KEY=AQEBAQEBAQEBAQEBAQEBAQEBAQEBAQEBAQEBAQEBAQE=
EMAIL_HASH_PEPPER=AgICAgICAgICAgICAgICAgICAgICAgICAgICAgICAgI=

# Shared bearer token apps/web sends on every apps/vault-svc /internal/*
# call (a Cloudflare service binding, not a public URL — see
# apps/vault-svc/src/auth.ts). Dev-only value; a deployed environment uses
# a real Wrangler secret instead.
VAULT_SVC_INTERNAL_TOKEN=local-dev-vault-svc-token

# Resend (transactional email — issue #20 AC: SES/Resend, not a new
# provider). Get a real key from https://resend.com to actually send the
# magic-link email locally — without one, the send call fails and
# /api/auth/register/start returns 500 (see start.ts).
RESEND_API_KEY=

# Cloudflare Turnstile (bot protection on the registration form). Leave
# blank for local dev — register.astro falls back to Cloudflare's publicly
# documented "always passes" test sitekey when running `astro dev`/
# `astro preview` (import.meta.env.DEV). Real keys from
# https://dash.cloudflare.com/?to=/:account/turnstile for a deployed
# environment.
# Cloudflare's publicly documented "always passes" test secret key
# (pairs with the test sitekey register.astro falls back to in dev).
TURNSTILE_SECRET_KEY=1x0000000000000000000000000000000AA
TURNSTILE_SITE_KEY=

# HMAC key signing the post-registration session cookie
# (packages/shared/src/session.ts). Dev-only value; rotate via a real
# Wrangler secret in deployed environments.
SESSION_SECRET=local-dev-session-secret-do-not-use-in-prod
