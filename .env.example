# Copy to .env and adjust if needed. .env is gitignored — never commit real
# values. Local dev values below match docker-compose.yml + the CI service
# container's credentials (postgres:postgres) so migrations/tests behave
# identically in both places. See CLAUDE.md invariant 6: production values
# for anything below never live in code — they come from Wrangler secrets /
# KV config instead.

# packages/db (participation DB, `public` schema). Superuser connection —
# used by drizzle-kit, the migrate script, and tests, which need to CREATE
# ROLE (anon/authenticated/service_role) and SET ROLE to exercise RLS.
DATABASE_URL=postgres://postgres:postgres@localhost:5432/prajasabha_dev

# packages/vault-db (identity vault, `vault` schema — schema itself lands in
# issue #16). Same physical container as DATABASE_URL for local dev only;
# see docker-compose.yml's header comment for why this is not the prod
# isolation boundary.
VAULT_DATABASE_URL=postgres://postgres:postgres@localhost:5432/prajasabha_dev?options=-c%20search_path%3Dvault

# Restricted, non-superuser LOGIN roles created by
# docker/postgres/init/01-schemas-and-roles.sql, scoped one-per-schema with
# no cross-grants. Not used by drizzle-kit/tests (those need superuser to
# CREATE ROLE) — these exist so you can manually verify the vault join rule
# is a real DB permission boundary, e.g.:
#   psql "postgres://app_role:app_role_dev_only@localhost:5432/prajasabha_dev" \
#     -c "select * from vault.anything"   # must fail: permission denied
#   psql "postgres://vault_role:vault_role_dev_only@localhost:5432/prajasabha_dev" \
#     -c "select * from public.members"   # must fail: permission denied
# APP_ROLE_DATABASE_URL=postgres://app_role:app_role_dev_only@localhost:5432/prajasabha_dev
# VAULT_ROLE_DATABASE_URL=postgres://vault_role:vault_role_dev_only@localhost:5432/prajasabha_dev

# packages/shared config-driven constants (issue #17). Values below are the
# PRD/HLD-adopted defaults; loadConfig() falls back to these same numbers
# when unset, so leaving these commented out is fine for local dev. Override
# here only to test a different threshold locally. Production values are
# Wrangler vars/secrets or KV-backed config, never hardcoded — see
# packages/shared/src/config.ts.
# CONCERN_THRESHOLD_T2=100
# QUORUM_PERCENT=20
# PANEL_TERM_MONTHS=6
