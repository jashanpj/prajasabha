# Copy to .env and adjust if needed. .env is gitignored — never commit real
# values. Local dev values below match docker-compose.yml + the CI service
# container's credentials (postgres:postgres) so migrations/tests behave
# identically in both places. See CLAUDE.md invariant 6: production values
# for anything below never live in code — they come from Wrangler secrets /
# KV config instead.

# packages/db (participation DB, `public` schema). Superuser connection —
# used by drizzle-kit, the migrate script, and tests, which need to CREATE
# ROLE (anon/authenticated/service_role/app_role) and SET ROLE to exercise
# RLS.
DATABASE_URL=postgres://postgres:postgres@localhost:5432/prajasabha_dev

# packages/vault-db (identity vault, `vault` schema). Superuser connection —
# used by drizzle-kit, the migrate script, and tests. Same physical
# container as DATABASE_URL for local dev only; see docker-compose.yml's
# header comment for why this is not the prod isolation boundary.
VAULT_DATABASE_URL=postgres://postgres:postgres@localhost:5432/prajasabha_dev?options=-c%20search_path%3Dvault

# apps/web's runtime connection to packages/db (issue #20). Connects as
# app_role — a LOGIN role created by docker/postgres/init/01-schemas-and-roles.sql
# (dev-only password, not a real secret) with no direct table grants of its
# own, only membership in service_role
# (packages/db/migrations/0002_grant_app_role_service_role.sql). Postgres
# role membership inherits privileges automatically, so app_role's queries
# run under service_role's own RLS policies/grants — see apps/web/src/lib/db.ts.
APP_DATABASE_URL=postgres://app_role:app_role_dev_only@localhost:5432/prajasabha_dev

# apps/vault-svc's runtime connection to packages/vault-db (issue #20).
# Connects directly as vault_role (same LOGIN role docker-compose already
# provisions) — vault_role's own grants from
# packages/vault-db/migrations/0000 are exactly what it needs, no
# indirection required.
VAULT_SVC_DATABASE_URL=postgres://vault_role:vault_role_dev_only@localhost:5432/prajasabha_dev

# packages/shared config-driven constants (issue #17). Required —
# loadConfig() throws if any of these are unset, deliberately: CLAUDE.md
# invariant 6 forbids these values as a silent fallback inside
# packages/shared/src/config.ts itself ("no secrets, thresholds, or
# rate-limit values in code... assume hostile readers of this public
# repo"), so the PRD/HLD-adopted numbers live only here — a gitignored
# local file — and in Wrangler vars/secrets for deployed environments.
CONCERN_THRESHOLD_T2=100
QUORUM_PERCENT=20
PANEL_TERM_MONTHS=6
DELIBERATION_OPEN_DAYS=14

# A1 magic-link registration (issue #20). loadMagicLinkConfig/
# loadRateLimitConfig throw if any of these are unset — same "no silent
# fallback" posture as above. Numbers here are reasonable MVP defaults, not
# sourced from product law (no doc specifies concrete figures).
MAGIC_LINK_TTL_MINUTES=15
REGISTER_RATE_LIMIT_PER_EMAIL_PER_HOUR=5
REGISTER_RATE_LIMIT_PER_IP_PER_HOUR=20
VERIFY_RATE_LIMIT_PER_IP_PER_HOUR=30

# apps/vault-svc: AES-GCM-256 key (encrypts the email so it can still be
# read back to actually send mail) and a separate HMAC-SHA256 pepper
# (one-way, duplicate-email lookup only — never reused as the encryption
# key). Dev-only values below — deliberately low-entropy (repeated-byte
# fill, not randomly generated) so they can't be mistaken for a leaked
# real key by gitleaks or a human skimming this file, while still being
# valid 32-byte keys for local dev's AES-GCM/HMAC calls. Deployed
# environments use real random Wrangler secrets, rotated independently.
EMAIL_ENCRYPTION_KEY=AQEBAQEBAQEBAQEBAQEBAQEBAQEBAQEBAQEBAQEBAQE=
EMAIL_HASH_PEPPER=AgICAgICAgICAgICAgICAgICAgICAgICAgICAgICAgI=

# Shared bearer token apps/web sends on every apps/vault-svc /internal/*
# call (a Cloudflare service binding, not a public URL — see
# apps/vault-svc/src/auth.ts). Dev-only value; a deployed environment uses
# a real Wrangler secret instead.
VAULT_SVC_INTERNAL_TOKEN=local-dev-vault-svc-token

# Resend (transactional email — issue #20 AC: SES/Resend, not a new
# provider). Get a real key from https://resend.com to actually send the
# magic-link email locally — without one, the send call fails and
# /api/auth/register/start returns 500 (see start.ts).
RESEND_API_KEY=

# Cloudflare Turnstile (bot protection on the registration form). Leave
# blank for local dev — register.astro falls back to Cloudflare's publicly
# documented "always passes" test sitekey when running `astro dev`/
# `astro preview` (import.meta.env.DEV). Real keys from
# https://dash.cloudflare.com/?to=/:account/turnstile for a deployed
# environment.
# Cloudflare's publicly documented "always passes" test secret key
# (pairs with the test sitekey register.astro falls back to in dev).
TURNSTILE_SECRET_KEY=1x0000000000000000000000000000000AA
TURNSTILE_SITE_KEY=

# HMAC key signing the post-registration session cookie
# (packages/shared/src/session.ts). Dev-only value; rotate via a real
# Wrangler secret in deployed environments.
SESSION_SECRET=local-dev-session-secret-do-not-use-in-prod

# apps/vault-svc: EPIC (voter ID) verification (issue #16/#22). Three
# secrets, distinct from EMAIL_ENCRYPTION_KEY/EMAIL_HASH_PEPPER above and
# from each other (never reuse a key for two purposes — see crypto.ts).
# Same dev-only, deliberately low-entropy posture as the email keys.
EPIC_HASH_PEPPER=AwMDAwMDAwMDAwMDAwMDAwMDAwMDAwMDAwMDAwMDAwM=
EPIC_ENCRYPTION_KEY=BAQEBAQEBAQEBAQEBAQEBAQEBAQEBAQEBAQEBAQEBAQ=
EPIC_DOC_ENCRYPTION_KEY=BQUFBQUFBQUFBQUFBQUFBQUFBQUFBQUFBQUFBQUFBQU=

# apps/vault-svc's /review/epic/* human-reviewer queue (issue #22) — a
# separate bearer token and IP allowlist from VAULT_SVC_INTERNAL_TOKEN
# (review-auth.ts's requireReviewAccess), never conflatable with it.
# Dev-only value / localhost-only allowlist.
REVIEW_QUEUE_TOKEN=local-dev-review-queue-token
REVIEW_QUEUE_IP_ALLOWLIST=127.0.0.1

# Rate limits on the EPIC-verification submit/link path (issue #22) —
# /public/epic/submit is reachable with no service-to-service auth at all
# (Turnstile only), and apps/web's /api/verify/epic/submit is the one call
# that can reveal "already verified by someone else" (409 duplicate_epic),
# so both get the same KV-backed per-IP/per-member limiting as A1's
# register/start.ts. Two separate vars, one per consuming service.
EPIC_SUBMIT_RATE_LIMIT_PER_IP_PER_HOUR=10
EPIC_LINK_RATE_LIMIT_PER_MEMBER_PER_HOUR=10

# A3 EPIC verification config (issue #22, packages/shared's
# loadEpicVerificationConfig). The pilot targets a single Lok Sabha
# constituency — no constituencies table exists, this is config, same
# pattern as CONCERN_THRESHOLD_T2 above. Placeholder/fictional names for
# local dev; real values for a deployed environment come from Wrangler vars.
PILOT_CONSTITUENCY_NAME_ML="പൈലറ്റ് മണ്ഡലം"
PILOT_CONSTITUENCY_NAME_EN="Pilot Constituency"
COVERED_ASSEMBLY_SEGMENTS="Test Assembly Segment"

# apps/web's verify/epic.astro posts the raw EPIC number/doc directly to
# apps/vault-svc's public endpoint from the browser (HLD §4.3's "separate
# origin") — this is vault-svc's own dev port (see
# apps/vault-svc/wrangler.jsonc's `dev.port`), never proxied through
# apps/web's own server. A deployed environment needs a real public
# hostname for vault-svc (tracked under issue #18's staging deploy).
PUBLIC_VAULT_SVC_URL=http://localhost:8789

# B1 "Raise an Issue" config (issue #24, packages/shared's
# loadIssueCategoriesConfig / loadPilotWardsConfig). Both are the same
# "config, not schema" treatment as the constituency vars above:
# issues.category is deliberately free text in packages/db (data-driven
# taxonomy, HLD §6) validated against this allow-list at publish time, and
# the pilot's wards live as three index-aligned comma lists (ids, Malayalam
# names, English names) rather than a wards table. Placeholder/fictional
# values for local dev; real values come from Wrangler vars.
ISSUE_CATEGORIES=roads,water,electricity,waste,streetlight,other
PILOT_WARD_IDS=3fa85f64-5717-4562-b3fc-2c963f66afa6,5b1b6e1e-1c1a-4e1a-9c1a-2c963f66afa6
PILOT_WARD_NAMES_ML="ടെസ്റ്റ് വാർഡ് 1,ടെസ്റ്റ് വാർഡ് 2"
PILOT_WARD_NAMES_EN="Test Ward 1,Test Ward 2"

# B1 endpoints are session-authed (not anonymous like registration), so no
# Turnstile — but every mutation endpoint in this codebase still rate-limits
# (packages/shared's loadIssueRateLimitConfig), per-member since the session
# cookie already ties every call to one member_id. Reasonable MVP defaults,
# not sourced from product law — tune via env.
ISSUE_CREATE_RATE_LIMIT_PER_MEMBER_PER_HOUR=20
ISSUE_DRAFT_RATE_LIMIT_PER_MEMBER_PER_HOUR=120
ISSUE_PHOTO_RATE_LIMIT_PER_MEMBER_PER_HOUR=60
ISSUE_PUBLISH_RATE_LIMIT_PER_MEMBER_PER_HOUR=20

# B2 "flag misrouting" endpoint (issue #25) — same session-authed,
# per-member rate-limit treatment as the B1 endpoints above. Reasonable
# MVP default, not sourced from product law — tune via env.
FLAG_ROUTING_RATE_LIMIT_PER_MEMBER_PER_HOUR=20

# B3 Support & Dedup (issue #26). ISSUE_SUPPORT_RATE_LIMIT_PER_MEMBER_PER_HOUR
# is the same session-authed, per-member rate-limit treatment as every other
# mutation endpoint above. ISSUE_MERGE_ADMIN_TOKEN/_IP_ALLOWLIST gate the
# internal-ops-only merge endpoint (no admin-role model exists yet in this
# codebase — see apps/web/src/lib/admin-auth.ts) the same two-factor
# bearer-token + IP-allowlist way apps/vault-svc's REVIEW_QUEUE_TOKEN/
# REVIEW_QUEUE_IP_ALLOWLIST already gate the EPIC review queue. Dev-only
# placeholder value / localhost-only allowlist.
ISSUE_SUPPORT_RATE_LIMIT_PER_MEMBER_PER_HOUR=20
ISSUE_MERGE_ADMIN_TOKEN=local-dev-issue-merge-admin-token
ISSUE_MERGE_ADMIN_IP_ALLOWLIST=127.0.0.1

# C2 Consensus Surface (issue #34). CONSENSUS_AGREEMENT_THRESHOLD_PERCENT/
# CONSENSUS_MIN_VOTERS are the "Broad agreement" thresholds — PRD-adjacent
# product numbers, same no-hardcode treatment as CONCERN_THRESHOLD_T2.
# Consumed starting with apps/jobs' lifecycle sweep (issue #35) and later by
# apps/web's consensus endpoint/page (issue #34).
CONSENSUS_AGREEMENT_THRESHOLD_PERCENT=70
CONSENSUS_MIN_VOTERS=30

# C3 Deliberation Lifecycle demo tooling (issue #35). Gates
# POST /api/admin/deliberations/sweep — a manual "run the lifecycle sweep
# now" trigger so a stakeholder demo isn't blocked on the real 14-day
# window. Same two-factor bearer-token + IP-allowlist shape as
# ISSUE_MERGE_ADMIN_TOKEN/_IP_ALLOWLIST above, deliberately separate vars
# (distinct endpoint, distinct blast radius). Dev-only placeholder value /
# localhost-only allowlist.
DELIBERATION_SWEEP_ADMIN_TOKEN=local-dev-deliberation-sweep-admin-token
DELIBERATION_SWEEP_ADMIN_IP_ALLOWLIST=127.0.0.1

# Shared bearer token apps/web sends on its one apps/jobs /internal/sweep
# call (a Cloudflare service binding, not a public URL — same
# VAULT_SVC_INTERNAL_TOKEN pattern above, see apps/jobs/src/index.ts).
# Dev-only value; a deployed environment uses a real Wrangler secret.
JOBS_INTERNAL_TOKEN=local-dev-jobs-internal-token

# C1 Statement Submission & Voting (issue #33). Same session-authed,
# per-member rate-limit treatment as every other mutation endpoint above.
# STATEMENT_MODERATION_ADMIN_TOKEN/_IP_ALLOWLIST gate the minimal
# moderation endpoint the same two-factor way ISSUE_MERGE_ADMIN_TOKEN/
# _IP_ALLOWLIST do (no admin-role model exists yet, and Module H's real
# moderation console, issue #29, isn't built) — dev-only placeholder value
# / localhost-only allowlist.
STATEMENT_SUBMIT_RATE_LIMIT_PER_MEMBER_PER_HOUR=20
STATEMENT_VOTE_RATE_LIMIT_PER_MEMBER_PER_HOUR=200
STATEMENT_MODERATION_ADMIN_TOKEN=local-dev-statement-moderation-admin-token
STATEMENT_MODERATION_ADMIN_IP_ALLOWLIST=127.0.0.1
