---
// 3px gradient accent line only — never a solid tricolour block/background
// (CLAUDE.md design law: "saffron never appears without green nearby...
// Tricolour appears only as a 3px gradient accent line"). Typically used
// as a hairline divider under a page header.
export interface Props {
  class?: string;
}

const { class: className } = Astro.props;
---

<div class:list={["ps-tricolour-hairline", className]} role="presentation" data-testid="ps-tricolour-hairline">
</div>

<style>
  .ps-tricolour-hairline {
    width: 100%;
    height: 3px;
    background: linear-gradient(
      to right,
      var(--color-saffron) 0%,
      var(--color-saffron) 33.3%,
      white 33.3%,
      white 66.6%,
      var(--color-green) 66.6%,
      var(--color-green) 100%
    );
  }
</style>
