        gap: 1.5em;
        padding: 1.5em;
        align-items: start;
      }
      .ps-issue-main,
      .ps-issue-sidebar {
        display: flex;
        flex-direction: column;
        gap: 1.5em;
      }
      .ps-routing-list {
        list-style: none;
        display: flex;
        flex-wrap: wrap;
        gap: 0.5em;
        padding: 0;
        margin: 0 0 0.75em;
      }
      .ps-routing-explainer-link {
        color: var(--color-navy);
        font-weight: 600;
        text-decoration: none;
      }
      .ps-timeline {
        padding-left: 1.2em;
      }
      .ps-timeline li {
        margin-bottom: 0.4em;
      }
      .ps-timeline__label {
        font-weight: 600;
        margin-right: 0.5em;
      }
      .ps-timeline time {
        color: var(--color-muted);
        font-size: var(--font-size-caption);
      }
      .ps-deliberation-subtitle {
        color: var(--color-muted);
        font-size: var(--font-size-caption);
        margin-top: -0.5em;
      }
      .ps-statement-card {
        background: #fff;
        border: 1px solid var(--color-card-border);
        border-radius: var(--radius-card);
        padding: 1.5em 1.75em;
        display: flex;
        flex-direction: column;
        gap: 1.1em;
        margin-top: 0.5em;
      }
      .ps-statement-quote {
        font-family: var(--font-family-heading);
        font-size: 1.25em;
        line-height: 1.45;
        margin: 0;
      }
      .ps-vote-buttons {
        display: flex;
        gap: 0.6em;
      }
      .ps-vote-btn {
        flex: 1;
        text-align: center;
        font-size: 0.9em;
        font-weight: 600;
        padding: 0.7em;
        border-radius: var(--radius-button);
        background: transparent;
