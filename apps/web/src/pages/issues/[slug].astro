---
import AuthorityChip from "../../components/AuthorityChip.astro";
import Button from "../../components/Button.astro";
import SiteChrome from "../../components/SiteChrome.astro";
import "../../styles/global.css";
import { schema } from "db";
import { and, eq } from "drizzle-orm";
import { verifySession } from "shared";
import en from "../../i18n/en.json";
import ml from "../../i18n/ml.json";
import { getServiceRoleDb } from "../../lib/db";

// B2 — public issue-detail page (issue #25). Didn't exist before this
// story (#24 only built the raise-a-new-issue form) — #28's Issue
// Timeline extends this same page with the event-log timeline later,
// not duplicated here. Public: no session required to VIEW a published
// issue (matches the issues_public_read/routings_public_read RLS
// policies from migration 0000 — this page just needs to enforce the
// same status='published' visibility in application logic too, since it
// reads via service_role, which RLS doesn't gate). Flagging misrouting
// DOES require a session (session-gated form vs. a sign-in prompt).
const locale = Astro.url.searchParams.get("lang") === "en" ? "en" : "ml";
const t: Record<string, string> = locale === "en" ? en : ml;

function notFoundResponse(): Response {
  return new Response(
    `<!doctype html><html lang="${locale}"><body><p>${t["issue.detail.notFound"]}</p></body></html>`,
    {
      status: 404,
      headers: { "Content-Type": "text/html; charset=utf-8" },
    },
  );
}

const slug = Astro.params.slug;
if (!slug) {
  return notFoundResponse();
}

// Same DEV-fallback pattern as verify/epic.astro's sessionSecret/siteKey:
// literal values matching .env.example for `astro dev`, real Cloudflare
// bindings everywhere else (`cloudflare:workers` doesn't resolve under
// plain `astro dev`).
const env = import.meta.env.DEV ? undefined : (await import("cloudflare:workers")).env;
const appDatabaseUrl = import.meta.env.DEV
  ? "postgres://app_role:app_role_dev_only@localhost:5432/prajasabha_dev"
  : env?.APP_DATABASE_URL;
const sessionSecret = import.meta.env.DEV
  ? "local-dev-session-secret-do-not-use-in-prod"
  : env?.SESSION_SECRET;

const sessionCookieValue = Astro.cookies.get("ps_session")?.value;
const session =
  sessionCookieValue && sessionSecret
    ? await verifySession(sessionCookieValue, sessionSecret)
    : null;

const db = getServiceRoleDb(appDatabaseUrl as string);
const [issue] = await db
  .select({
    issueId: schema.issues.issueId,
    titleMl: schema.issues.titleMl,
    titleEn: schema.issues.titleEn,
    body: schema.issues.body,
    category: schema.issues.category,
    status: schema.issues.status,
    mergedInto: schema.issues.mergedInto,
    supportT2Count: schema.issues.supportT2Count,
  })
  .from(schema.issues)
  .where(eq(schema.issues.slug, slug))
  .limit(1);

// B3 (issue #26): a merged issue's own page must stay reachable ("merge
// preserves both threads' history") — only draft/closed are hidden.
if (!issue || (issue.status !== "published" && issue.status !== "merged")) {
  return notFoundResponse();
}

let mergedIntoSlug: string | null = null;
if (issue.status === "merged" && issue.mergedInto) {
  const [target] = await db
    .select({ slug: schema.issues.slug })
    .from(schema.issues)
    .where(eq(schema.issues.issueId, issue.mergedInto))
    .limit(1);
  mergedIntoSlug = target?.slug ?? null;
}

const routingRows = await db
  .select({
    role: schema.routings.role,
    legalBasisRef: schema.routings.legalBasisRef,
    authorityNameMl: schema.authorities.nameMl,
    authorityNameEn: schema.authorities.nameEn,
  })
  .from(schema.routings)
  .innerJoin(schema.authorities, eq(schema.routings.authorityId, schema.authorities.authorityId))
  .where(eq(schema.routings.issueId, issue.issueId));

function authorityName(row: (typeof routingRows)[number]): string {
  return locale === "en" ? row.authorityNameEn : row.authorityNameMl;
}
function roleLabel(role: "responsible" | "copied"): string {
  return role === "responsible"
    ? t["issue.routing.role.responsible"]
    : t["issue.routing.role.copied"];
}

const title = locale === "en" ? issue.titleEn : issue.titleMl;
const categoryLabel = t[`issue.category.${issue.category}`] ?? issue.category;
const memberId = session?.memberId ?? null;

// B3 (issue #26) — support/dedup: supporter pseudonyms + a per-ward
// breakdown, plus a T2-gated support form. None of this applies to a
// merged issue (its own supportT2Count is frozen at merge time and its
// issue_support rows have already moved to the target).
const DEV_WARDS = [
  { id: "3fa85f64-5717-4562-b3fc-2c963f66afa6", nameMl: "ടെസ്റ്റ് വാർഡ് 1", nameEn: "Test Ward 1" },
  { id: "5b1b6e1e-1c1a-4e1a-9c1a-2c963f66afa6", nameMl: "ടെസ്റ്റ് വാർഡ് 2", nameEn: "Test Ward 2" },
];
let pilotWards = DEV_WARDS;
if (!import.meta.env.DEV) {
  const { loadPilotWardsConfig } = await import("shared");
  pilotWards = loadPilotWardsConfig(
    env as unknown as Record<string, string | undefined>,
  ).pilotWards;
}
function wardName(wardId: string): string {
  const ward = pilotWards.find((w) => w.id === wardId);
  if (!ward) return t["issue.detail.support.wardBreakdown.other"];
  return locale === "en" ? ward.nameEn : ward.nameMl;
}

let supporterRows: { pseudonym: string; wardId: string }[] = [];
let memberTier: "t0" | "t1" | "t2" | null = null;
if (issue.status === "published") {
  supporterRows = await db
    .select({ pseudonym: schema.members.pseudonym, wardId: schema.issueSupport.wardId })
    .from(schema.issueSupport)
    .innerJoin(schema.members, eq(schema.issueSupport.memberId, schema.members.memberId))
    .where(eq(schema.issueSupport.issueId, issue.issueId));

  if (memberId) {
    const [member] = await db
      .select({ tier: schema.members.tier })
      .from(schema.members)
      .where(eq(schema.members.memberId, memberId))
      .limit(1);
    memberTier = member?.tier ?? null;
  }
}

const wardCounts = new Map<string, number>();
for (const row of supporterRows) {
  wardCounts.set(row.wardId, (wardCounts.get(row.wardId) ?? 0) + 1);
}
const wardBreakdown = [...wardCounts.entries()]
  .map(([wardId, count]) => ({ name: wardName(wardId), count }))
  .sort((a, b) => b.count - a.count);

// B5 — Issue Timeline (issue #28). Generated purely from the append-only
// event_log — no separate mutable "timeline" table (invariant 3: no
// UPDATE/DELETE is even possible on these rows). Only a localized label
// per `kind` + timestamp is rendered, never the raw `payload` — a
// deliberate safety default, since e.g. `issue_routing_flagged`'s payload
// carries a free-text member-submitted note that must never be public.
const timelineRows = await db
  .select({ kind: schema.eventLog.kind, at: schema.eventLog.at })
  .from(schema.eventLog)
  .where(
    and(eq(schema.eventLog.subjectType, "issue"), eq(schema.eventLog.subjectId, issue.issueId)),
  )
  .orderBy(schema.eventLog.at);
function timelineLabel(kind: string): string {
  return t[`issue.timeline.kind.${kind}`] ?? kind;
}
function timelineTimestamp(at: Date): string {
  return at.toLocaleString(locale === "en" ? "en-IN" : "ml-IN", {
    dateStyle: "medium",
    timeStyle: "short",
  });
}
---

<html lang={locale}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
  </head>
  <body>
    <SiteChrome locale={locale}>
      <nav class="ps-breadcrumb" aria-label={t["nav.breadcrumb.label"]}>
        <a href={`/dashboard?lang=${locale}`}>{t["nav.dashboard"]}</a>
        <span aria-hidden="true">/</span>
        <span>{title}</span>
      </nav>

      <div class="ps-issue-layout">
        <div class="ps-issue-main">
          <div class="ps-card">
            <h1>{title}</h1>
            <p class="ps-issue-category">{categoryLabel}</p>
            <p class="ps-issue-body">{issue.body}</p>

            {issue.status === "merged" && (
              <p class="ps-merged-attribution">
                {t["issue.merged.attribution"].replace("{count}", `${issue.supportT2Count}`)}
                {mergedIntoSlug && (
                  <>
                    {" "}
                    <a href={`/issues/${mergedIntoSlug}`}>{t["issue.merged.viewLink"]}</a>
                  </>
                )}
              </p>
            )}
          </div>

          {issue.status === "published" && (
            <div class="ps-card">
              <h2>{t["issue.detail.routing.title"]}</h2>
              {routingRows.length === 0 ? (
                <p>{t["issue.detail.routing.empty"]}</p>
              ) : (
                <>
                  <ul class="ps-routing-list">
                    {routingRows.map((row) => (
                      <li>
                        <AuthorityChip
                          role={row.role}
                          authorityName={authorityName(row)}
                          roleLabel={roleLabel(row.role)}
                        />
                      </li>
                    ))}
                  </ul>
                  <a href={`/issues/${slug}/routing?lang=${locale}`} class="ps-routing-explainer-link">
                    {t["issue.detail.routing.whyLink"]}
                  </a>
                </>
              )}
            </div>
          )}

          {issue.status === "published" && (
            <div class="ps-card">
              {memberId ? (
                <form id="flag-form" class="ps-form">
                  <label>
                    {t["issue.detail.flag.note.label"]}
                    <textarea name="note" maxlength="500" rows="3" />
                  </label>
                  <p id="flag-error" class="ps-form-error" role="alert" hidden />
                  <p id="flag-success" role="status" hidden>
                    {t["issue.detail.flag.success"]}
                  </p>
                  <Button type="submit">{t["issue.detail.flag.button"]}</Button>
                </form>
              ) : (
                <p>{t["issue.detail.flag.loginPrompt"]}</p>
              )}
            </div>
          )}
        </div>

        <div class="ps-issue-sidebar">
          {issue.status === "published" && (
            <div class="ps-card">
              <h2 class="tabular-nums">
                {t["issue.detail.support.count"].replace("{count}", `${issue.supportT2Count}`)}
              </h2>

              {wardBreakdown.length > 0 && (
                <div>
                  <h3>{t["issue.detail.support.wardBreakdown.title"]}</h3>
                  <ul>
                    {wardBreakdown.map((entry) => (
                      <li>
                        {entry.name} {entry.count}
                      </li>
                    ))}
                  </ul>
                </div>
              )}

              {supporterRows.length > 0 && (
                <div>
                  <h3>{t["issue.detail.support.supporters.title"]}</h3>
                  <ul class="ps-supporter-list">
                    {supporterRows.map((row) => (
                      <li>{row.pseudonym}</li>
                    ))}
                  </ul>
                </div>
              )}

              {memberId ? (
                memberTier === "t2" ? (
                  <form id="support-form" class="ps-form">
                    <label>
                      {t["issue.detail.support.ward.label"]}
                      <select name="wardId" required>
                        {pilotWards.map((ward) => (
                          <option value={ward.id}>
                            {locale === "en" ? ward.nameEn : ward.nameMl}
                          </option>
                        ))}
                      </select>
                    </label>
                    <p id="support-error" class="ps-form-error" role="alert" hidden />
                    <p id="support-success" role="status" hidden>
                      {t["issue.detail.support.success"]}
                    </p>
                    <Button type="submit">{t["issue.detail.support.button"]}</Button>
                  </form>
                ) : (
                  <p>{t["issue.detail.support.tierPrompt"]}</p>
                )
              ) : (
                <p>{t["issue.detail.support.loginPrompt"]}</p>
              )}
            </div>
          )}

          <div class="ps-card">
            <h2>{t["issue.timeline.title"]}</h2>
            <ol class="ps-timeline">
              {timelineRows.map((row) => (
                <li>
                  <span class="ps-timeline__label">{timelineLabel(row.kind)}</span>
                  <time>{timelineTimestamp(row.at)}</time>
                </li>
              ))}
            </ol>
          </div>
        </div>
      </div>

    <script define:vars={{ t, issueId: issue.issueId }} type="module">
      const supportForm = document.getElementById("support-form");
      if (supportForm) {
        const errorEl = document.getElementById("support-error");
        const successEl = document.getElementById("support-success");

        supportForm.addEventListener("submit", async (event) => {
          event.preventDefault();
          errorEl.hidden = true;
          successEl.hidden = true;

          const submitButton = supportForm.querySelector("button[type=submit]");
          submitButton.disabled = true;
          const originalLabel = submitButton.textContent;
          submitButton.textContent = t["issue.detail.support.submitting"];

          try {
            const data = new FormData(supportForm);
            const res = await fetch(`/api/issues/${issueId}/support`, {
              method: "POST",
              headers: { "Content-Type": "application/json" },
              body: JSON.stringify({ wardId: data.get("wardId") }),
            });

            if (res.status === 201) {
              successEl.hidden = false;
              submitButton.disabled = true;
              return;
            }

            const json = await res.json().catch(() => ({}));
            errorEl.textContent =
              t[`issue.detail.support.error.${json.error}`] ?? t["issue.detail.support.error.generic"];
            errorEl.hidden = false;
            submitButton.disabled = false;
          } catch {
            errorEl.textContent = t["issue.detail.support.error.generic"];
            errorEl.hidden = false;
            submitButton.disabled = false;
          } finally {
            submitButton.textContent = originalLabel;
          }
        });
      }

      const form = document.getElementById("flag-form");
      if (form) {
        const errorEl = document.getElementById("flag-error");
        const successEl = document.getElementById("flag-success");

        form.addEventListener("submit", async (event) => {
          event.preventDefault();
          errorEl.hidden = true;
          successEl.hidden = true;

          const submitButton = form.querySelector("button[type=submit]");
          submitButton.disabled = true;
          const originalLabel = submitButton.textContent;
          submitButton.textContent = t["issue.detail.flag.submitting"];

          try {
            const data = new FormData(form);
            const res = await fetch(`/api/issues/${issueId}/flag-routing`, {
              method: "POST",
              headers: { "Content-Type": "application/json" },
              body: JSON.stringify({ note: data.get("note") || undefined }),
            });

            if (res.status === 201) {
              successEl.hidden = false;
              form.reset();
              return;
            }

            const json = await res.json().catch(() => ({}));
            errorEl.textContent = t[`issue.detail.flag.error.${json.error}`] ?? t["issue.detail.flag.error.generic"];
            errorEl.hidden = false;
          } catch {
            errorEl.textContent = t["issue.detail.flag.error.generic"];
            errorEl.hidden = false;
          } finally {
            submitButton.disabled = false;
            submitButton.textContent = originalLabel;
          }
        });
      }
    </script>

    <style>
      .ps-breadcrumb {
        padding: 1em 1.5em 0;
        color: var(--color-muted);
        font-size: var(--font-size-caption);
      }
      .ps-breadcrumb a {
        color: var(--color-navy);
        text-decoration: none;
      }
      .ps-issue-layout {
        display: grid;
        grid-template-columns: 2fr 1fr;
        gap: 1.5em;
        padding: 1.5em;
        align-items: start;
      }
      .ps-issue-main,
      .ps-issue-sidebar {
        display: flex;
        flex-direction: column;
        gap: 1.5em;
      }
      .ps-routing-list {
        list-style: none;
        display: flex;
        flex-wrap: wrap;
        gap: 0.5em;
        padding: 0;
        margin: 0 0 0.75em;
      }
      .ps-routing-explainer-link {
        color: var(--color-navy);
        font-weight: 600;
        text-decoration: none;
      }
      .ps-timeline {
        padding-left: 1.2em;
      }
      .ps-timeline li {
        margin-bottom: 0.4em;
      }
      .ps-timeline__label {
        font-weight: 600;
        margin-right: 0.5em;
      }
      .ps-timeline time {
        color: var(--color-muted);
        font-size: var(--font-size-caption);
      }
    </style>
    </SiteChrome>
  </body>
</html>
