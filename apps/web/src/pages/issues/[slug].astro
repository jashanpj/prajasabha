---
import AuthorityChip from "../../components/AuthorityChip.astro";
import Button from "../../components/Button.astro";
import SiteChrome from "../../components/SiteChrome.astro";
import "../../styles/global.css";
import { schema } from "db";
import { and, eq, sql } from "drizzle-orm";
import { verifySession } from "shared";
import en from "../../i18n/en.json";
import ml from "../../i18n/ml.json";
import { getServiceRoleDb } from "../../lib/db";

// B2 — public issue-detail page (issue #25). Didn't exist before this
// story (#24 only built the raise-a-new-issue form) — #28's Issue
// Timeline extends this same page with the event-log timeline later,
// not duplicated here. Public: no session required to VIEW a published
// issue (matches the issues_public_read/routings_public_read RLS
// policies from migration 0000 — this page just needs to enforce the
// same status='published' visibility in application logic too, since it
// reads via service_role, which RLS doesn't gate). Flagging misrouting
// DOES require a session (session-gated form vs. a sign-in prompt).
const locale = Astro.url.searchParams.get("lang") === "en" ? "en" : "ml";
const t: Record<string, string> = locale === "en" ? en : ml;

function notFoundResponse(): Response {
  return new Response(
    `<!doctype html><html lang="${locale}"><body><p>${t["issue.detail.notFound"]}</p></body></html>`,
    {
      status: 404,
      headers: { "Content-Type": "text/html; charset=utf-8" },
    },
  );
}

const slug = Astro.params.slug;
if (!slug) {
  return notFoundResponse();
}

// Same DEV-fallback pattern as verify/epic.astro's sessionSecret/siteKey:
// literal values matching .env.example for `astro dev`, real Cloudflare
// bindings everywhere else (`cloudflare:workers` doesn't resolve under
// plain `astro dev`).
const env = import.meta.env.DEV ? undefined : (await import("cloudflare:workers")).env;
const appDatabaseUrl = import.meta.env.DEV
  ? "postgres://app_role:app_role_dev_only@localhost:5432/prajasabha_dev"
  : env?.APP_DATABASE_URL;
const sessionSecret = import.meta.env.DEV
  ? "local-dev-session-secret-do-not-use-in-prod"
  : env?.SESSION_SECRET;

const sessionCookieValue = Astro.cookies.get("ps_session")?.value;
const session =
  sessionCookieValue && sessionSecret
    ? await verifySession(sessionCookieValue, sessionSecret)
    : null;

const db = getServiceRoleDb(appDatabaseUrl as string);
const [issue] = await db
  .select({
    issueId: schema.issues.issueId,
    titleMl: schema.issues.titleMl,
    titleEn: schema.issues.titleEn,
    body: schema.issues.body,
    category: schema.issues.category,
    status: schema.issues.status,
    mergedInto: schema.issues.mergedInto,
    supportT2Count: schema.issues.supportT2Count,
  })
  .from(schema.issues)
  .where(eq(schema.issues.slug, slug))
  .limit(1);

// B3 (issue #26): a merged issue's own page must stay reachable ("merge
// preserves both threads' history") — only draft/closed are hidden.
if (!issue || (issue.status !== "published" && issue.status !== "merged")) {
  return notFoundResponse();
}

let mergedIntoSlug: string | null = null;
if (issue.status === "merged" && issue.mergedInto) {
  const [target] = await db
    .select({ slug: schema.issues.slug })
    .from(schema.issues)
    .where(eq(schema.issues.issueId, issue.mergedInto))
    .limit(1);
  mergedIntoSlug = target?.slug ?? null;
}

const routingRows = await db
  .select({
    role: schema.routings.role,
    legalBasisRef: schema.routings.legalBasisRef,
    authorityNameMl: schema.authorities.nameMl,
    authorityNameEn: schema.authorities.nameEn,
  })
  .from(schema.routings)
  .innerJoin(schema.authorities, eq(schema.routings.authorityId, schema.authorities.authorityId))
  .where(eq(schema.routings.issueId, issue.issueId));

function authorityName(row: (typeof routingRows)[number]): string {
  return locale === "en" ? row.authorityNameEn : row.authorityNameMl;
}
function roleLabel(role: "responsible" | "copied"): string {
  return role === "responsible"
    ? t["issue.routing.role.responsible"]
    : t["issue.routing.role.copied"];
}

const title = locale === "en" ? issue.titleEn : issue.titleMl;
const categoryLabel = t[`issue.category.${issue.category}`] ?? issue.category;
const memberId = session?.memberId ?? null;

// B3 (issue #26) — support/dedup: supporter pseudonyms + a per-ward
// breakdown, plus a T2-gated support form. None of this applies to a
// merged issue (its own supportT2Count is frozen at merge time and its
// issue_support rows have already moved to the target).
const DEV_WARDS = [
  { id: "3fa85f64-5717-4562-b3fc-2c963f66afa6", nameMl: "ടെസ്റ്റ് വാർഡ് 1", nameEn: "Test Ward 1" },
  { id: "5b1b6e1e-1c1a-4e1a-9c1a-2c963f66afa6", nameMl: "ടെസ്റ്റ് വാർഡ് 2", nameEn: "Test Ward 2" },
];
let pilotWards = DEV_WARDS;
if (!import.meta.env.DEV) {
  const { loadPilotWardsConfig } = await import("shared");
  pilotWards = loadPilotWardsConfig(
    env as unknown as Record<string, string | undefined>,
  ).pilotWards;
}
function wardName(wardId: string): string {
  const ward = pilotWards.find((w) => w.id === wardId);
  if (!ward) return t["issue.detail.support.wardBreakdown.other"];
  return locale === "en" ? ward.nameEn : ward.nameMl;
}

// C3 — Deliberation Lifecycle (issue #35). A `deliberations` row only ever
// exists once this issue has crossed the concern threshold and been
// promoted (support.ts's CAS transaction opens it atomically with
// promotion) — so, like the support sidebar below, this is gated on
// `published` and simply absent otherwise, not stubbed/faked.
let deliberation: { deliberationId: string; state: string; closesAt: Date } | null = null;
if (issue.status === "published") {
  const [row] = await db
    .select({
      deliberationId: schema.deliberations.deliberationId,
      state: schema.deliberations.state,
      closesAt: schema.deliberations.closesAt,
    })
    .from(schema.deliberations)
    .where(eq(schema.deliberations.issueId, issue.issueId))
    .limit(1);
  deliberation = row ?? null;
}
function deliberationStateLabel(state: string, closesAt: Date): string {
  const template = t[`issue.detail.deliberation.state.${state}`] ?? state;
  return template.replace("{closesAt}", timelineTimestamp(closesAt));
}

// C2 — Consensus Surface (issue #34). Computed fresh on every page load
// (not the frozen PDF, which is generated once by apps/jobs' cron sweep on
// the closed->summarized transition — see consensus-export.ts) — the same
// computeConsensus function (packages/shared) both sides use, so the math
// can never drift between the live page and the exported artifact.
// Rendered whenever a deliberation exists, at any state: consensus is
// meaningful to show even before the deliberation closes.
let consensusStatements: {
  statementId: string;
  body: string;
  agreePercent: number;
  sampleSize: number;
  meetsThreshold: boolean;
}[] = [];
let totalT2Count: number | null = null;
if (deliberation) {
  const { computeConsensus, loadConsensusConfig } = await import("shared");
  const consensusConfig = import.meta.env.DEV
    ? { agreementThresholdPercent: 70, minVoters: 30 }
    : loadConsensusConfig(env as unknown as Record<string, string | undefined>);

  const approvedStatements = await db
    .select({ statementId: schema.statements.statementId, body: schema.statements.body })
    .from(schema.statements)
    .where(
      and(
        eq(schema.statements.deliberationId, deliberation.deliberationId),
        eq(schema.statements.status, "approved"),
      ),
    );

  const votes = await db
    .select({ statementId: schema.statementVotes.statementId, vote: schema.statementVotes.vote })
    .from(schema.statementVotes)
    .innerJoin(
      schema.statements,
      eq(schema.statements.statementId, schema.statementVotes.statementId),
    )
    .where(
      and(
        eq(schema.statements.deliberationId, deliberation.deliberationId),
        eq(schema.statements.status, "approved"),
      ),
    );

  const talliesByStatementId = new Map(
    approvedStatements.map((s) => [
      s.statementId,
      { statementId: s.statementId, body: s.body, agree: 0, disagree: 0, pass: 0 },
    ]),
  );
  for (const v of votes) {
    const tally = talliesByStatementId.get(v.statementId);
    if (tally) tally[v.vote] += 1;
  }

  consensusStatements = computeConsensus([...talliesByStatementId.values()], consensusConfig);

  const [t2CountRow] = await db
    .select({ count: sql<number>`count(*)::int` })
    .from(schema.members)
    .where(eq(schema.members.tier, "t2"));
  totalT2Count = t2CountRow?.count ?? null;
}
const broadAgreementStatements = consensusStatements.filter((s) => s.meetsThreshold);
function sampleSizeCaveat(sampleSize: number): string {
  if (totalT2Count === null || totalT2Count === 0) {
    return t["issue.detail.consensus.sampleOnly"].replace("{sampleSize}", `${sampleSize}`);
  }
  const t2Share = Math.round((sampleSize / totalT2Count) * 100);
  return t["issue.detail.consensus.sampleCaveat"]
    .replace("{sampleSize}", `${sampleSize}`)
    .replace("{totalT2Count}", `${totalT2Count}`)
    .replace("{t2Share}", `${t2Share}`);
}

let supporterRows: { pseudonym: string; wardId: string }[] = [];
let memberTier: "t0" | "t1" | "t2" | null = null;
if (issue.status === "published") {
  supporterRows = await db
    .select({ pseudonym: schema.members.pseudonym, wardId: schema.issueSupport.wardId })
    .from(schema.issueSupport)
    .innerJoin(schema.members, eq(schema.issueSupport.memberId, schema.members.memberId))
    .where(eq(schema.issueSupport.issueId, issue.issueId));

  if (memberId) {
    const [member] = await db
      .select({ tier: schema.members.tier })
      .from(schema.members)
      .where(eq(schema.members.memberId, memberId))
      .limit(1);
    memberTier = member?.tier ?? null;
  }
}

const wardCounts = new Map<string, number>();
for (const row of supporterRows) {
  wardCounts.set(row.wardId, (wardCounts.get(row.wardId) ?? 0) + 1);
}
const wardBreakdown = [...wardCounts.entries()]
  .map(([wardId, count]) => ({ name: wardName(wardId), count }))
  .sort((a, b) => b.count - a.count);

// B5 — Issue Timeline (issue #28). Generated purely from the append-only
// event_log — no separate mutable "timeline" table (invariant 3: no
// UPDATE/DELETE is even possible on these rows). Only a localized label
// per `kind` + timestamp is rendered, never the raw `payload` — a
// deliberate safety default, since e.g. `issue_routing_flagged`'s payload
// carries a free-text member-submitted note that must never be public.
const timelineRows = await db
  .select({ kind: schema.eventLog.kind, at: schema.eventLog.at })
  .from(schema.eventLog)
  .where(
    and(eq(schema.eventLog.subjectType, "issue"), eq(schema.eventLog.subjectId, issue.issueId)),
  )
  .orderBy(schema.eventLog.at);
function timelineLabel(kind: string): string {
  return t[`issue.timeline.kind.${kind}`] ?? kind;
}
function timelineTimestamp(at: Date): string {
  return at.toLocaleString(locale === "en" ? "en-IN" : "ml-IN", {
    dateStyle: "medium",
    timeStyle: "short",
  });
}
---

<html lang={locale}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
  </head>
  <body>
    <SiteChrome locale={locale}>
      <nav class="ps-breadcrumb" aria-label={t["nav.breadcrumb.label"]}>
        <a href={`/dashboard?lang=${locale}`}>{t["nav.dashboard"]}</a>
        <span aria-hidden="true">/</span>
        <span>{title}</span>
      </nav>

      <div class="ps-issue-layout">
        <div class="ps-issue-main">
          <div class="ps-card">
            <h1>{title}</h1>
            <p class="ps-issue-category">{categoryLabel}</p>
            <p class="ps-issue-body">{issue.body}</p>

            {issue.status === "merged" && (
              <p class="ps-merged-attribution">
                {t["issue.merged.attribution"].replace("{count}", `${issue.supportT2Count}`)}
                {mergedIntoSlug && (
                  <>
                    {" "}
                    <a href={`/issues/${mergedIntoSlug}`}>{t["issue.merged.viewLink"]}</a>
                  </>
                )}
              </p>
            )}
          </div>

          {deliberation && (deliberation.state === "closed" || deliberation.state === "summarized") && (
            <div class="ps-card">
              <h2>{t["issue.detail.deliberation.title"]}</h2>
              <p>{deliberationStateLabel(deliberation.state, deliberation.closesAt)}</p>
            </div>
          )}

          {deliberation && (deliberation.state === "open" || deliberation.state === "extended") && (
            <div class="ps-card">
              <h2>{t["issue.detail.deliberation.title"]}</h2>
              <p class="ps-deliberation-subtitle">{t["issue.detail.deliberation.subtitle"]}</p>

              {memberId && memberTier === "t2" ? (
                <>
                  <div id="deliberation-statement-card" class="ps-statement-card" hidden>
                    <blockquote id="deliberation-statement-body" class="ps-statement-quote"></blockquote>
                    <div class="ps-vote-buttons">
                      <button type="button" class="ps-vote-btn ps-vote-btn--agree" data-vote="agree">
                        {t["issue.detail.deliberation.vote.agree"]}
                      </button>
                      <button type="button" class="ps-vote-btn ps-vote-btn--disagree" data-vote="disagree">
                        {t["issue.detail.deliberation.vote.disagree"]}
                      </button>
                      <button type="button" class="ps-vote-btn ps-vote-btn--pass" data-vote="pass">
                        {t["issue.detail.deliberation.vote.pass"]}
                      </button>
                    </div>
                    <p id="deliberation-vote-error" class="ps-form-error" role="alert" hidden />
                  </div>
                  <p id="deliberation-empty" hidden>{t["issue.detail.deliberation.noneLeft"]}</p>
                  <p id="deliberation-position" class="ps-deliberation-position tabular-nums"></p>

                  <form id="statement-form" class="ps-form">
                    <label>
                      {t["issue.detail.deliberation.submit.label"]}
                      <textarea name="body" maxlength="280" rows="3" required></textarea>
                    </label>
                    <p id="statement-char-count" class="ps-char-count tabular-nums">0 / 280</p>
                    <p id="statement-error" class="ps-form-error" role="alert" hidden />
                    <p id="statement-success" role="status" hidden>
                      {t["issue.detail.deliberation.submit.success"]}
                    </p>
                    <Button type="submit">{t["issue.detail.deliberation.submit.button"]}</Button>
                  </form>
                </>
              ) : memberId ? (
                <p>{t["issue.detail.deliberation.tierPrompt"]}</p>
              ) : (
                <p>{t["issue.detail.deliberation.loginPrompt"]}</p>
              )}
            </div>
          )}

          {deliberation && consensusStatements.length > 0 && (
            <div class="ps-card">
              <h2>{t["issue.detail.consensus.title"]}</h2>
              <p class="ps-deliberation-subtitle">{t["issue.detail.consensus.subtitle"]}</p>

              {broadAgreementStatements.length > 0 && (
                <div class="ps-broad-agreement">
                  <h3>{t["issue.detail.consensus.broadAgreement.title"]}</h3>
                  <ul class="ps-consensus-list">
                    {broadAgreementStatements.map((s) => (
                      <li>
                        <span class="ps-consensus-body">{s.body}</span>
                        <span class="ps-consensus-bar">
                          <span class="ps-consensus-bar__fill ps-consensus-bar__fill--meets" style={`width:${s.agreePercent}%`} />
                        </span>
                        <span class="ps-consensus-percent ps-consensus-percent--meets tabular-nums">
                          {t["issue.detail.consensus.percentAgree"].replace("{percent}", `${s.agreePercent}`)}
                        </span>
                        <span class="ps-consensus-caveat">{sampleSizeCaveat(s.sampleSize)}</span>
                      </li>
                    ))}
                  </ul>
                </div>
              )}

              <div class="ps-all-statements">
                <h3>{t["issue.detail.consensus.allStatements.title"]}</h3>
                <ul class="ps-consensus-list">
                  {consensusStatements.map((s) => (
                    <li>
                      <span class="ps-consensus-body">{s.body}</span>
                      <span class="ps-consensus-bar">
                        <span
                          class={`ps-consensus-bar__fill ${s.meetsThreshold ? "ps-consensus-bar__fill--meets" : ""}`}
                          style={`width:${s.agreePercent}%`}
                        />
                      </span>
                      <span
                        class={`ps-consensus-percent tabular-nums ${s.meetsThreshold ? "ps-consensus-percent--meets" : ""}`}
                      >
                        {t["issue.detail.consensus.percentAgree"].replace("{percent}", `${s.agreePercent}`)}
                      </span>
                      <span class="ps-consensus-caveat">{sampleSizeCaveat(s.sampleSize)}</span>
                    </li>
                  ))}
                </ul>
              </div>

              {deliberation.state === "summarized" && (
                <a
                  href={`/api/issues/${issue.issueId}/consensus-export`}
                  class="ps-routing-explainer-link"
                >
                  {t["issue.detail.consensus.downloadReport"]}
                </a>
              )}
            </div>
          )}

          {issue.status === "published" && (
            <div class="ps-card">
              <h2>{t["issue.detail.routing.title"]}</h2>
              {routingRows.length === 0 ? (
                <p>{t["issue.detail.routing.empty"]}</p>
              ) : (
                <>
                  <ul class="ps-routing-list">
                    {routingRows.map((row) => (
                      <li>
                        <AuthorityChip
                          role={row.role}
                          authorityName={authorityName(row)}
                          roleLabel={roleLabel(row.role)}
                        />
                      </li>
                    ))}
                  </ul>
                  <a href={`/issues/${slug}/routing?lang=${locale}`} class="ps-routing-explainer-link">
                    {t["issue.detail.routing.whyLink"]}
                  </a>
                </>
              )}
            </div>
          )}

          {issue.status === "published" && (
            <div class="ps-card">
              {memberId ? (
                <form id="flag-form" class="ps-form">
                  <label>
                    {t["issue.detail.flag.note.label"]}
                    <textarea name="note" maxlength="500" rows="3" />
                  </label>
                  <p id="flag-error" class="ps-form-error" role="alert" hidden />
                  <p id="flag-success" role="status" hidden>
                    {t["issue.detail.flag.success"]}
                  </p>
                  <Button type="submit">{t["issue.detail.flag.button"]}</Button>
                </form>
              ) : (
                <p>{t["issue.detail.flag.loginPrompt"]}</p>
              )}
            </div>
          )}
        </div>

        <div class="ps-issue-sidebar">
          {issue.status === "published" && (
            <div class="ps-card">
              <h2 class="tabular-nums">
                {t["issue.detail.support.count"].replace("{count}", `${issue.supportT2Count}`)}
              </h2>

              {wardBreakdown.length > 0 && (
                <div>
                  <h3>{t["issue.detail.support.wardBreakdown.title"]}</h3>
                  <ul>
                    {wardBreakdown.map((entry) => (
                      <li>
                        {entry.name} {entry.count}
                      </li>
                    ))}
                  </ul>
                </div>
              )}

              {supporterRows.length > 0 && (
                <div>
                  <h3>{t["issue.detail.support.supporters.title"]}</h3>
                  <ul class="ps-supporter-list">
                    {supporterRows.map((row) => (
                      <li>{row.pseudonym}</li>
                    ))}
                  </ul>
                </div>
              )}

              {memberId ? (
                memberTier === "t2" ? (
                  <form id="support-form" class="ps-form">
                    <label>
                      {t["issue.detail.support.ward.label"]}
                      <select name="wardId" required>
                        {pilotWards.map((ward) => (
                          <option value={ward.id}>
                            {locale === "en" ? ward.nameEn : ward.nameMl}
                          </option>
                        ))}
                      </select>
                    </label>
                    <p id="support-error" class="ps-form-error" role="alert" hidden />
                    <p id="support-success" role="status" hidden>
                      {t["issue.detail.support.success"]}
                    </p>
                    <Button type="submit">{t["issue.detail.support.button"]}</Button>
                  </form>
                ) : (
                  <p>{t["issue.detail.support.tierPrompt"]}</p>
                )
              ) : (
                <p>{t["issue.detail.support.loginPrompt"]}</p>
              )}
            </div>
          )}

          <div class="ps-card">
            <h2>{t["issue.timeline.title"]}</h2>
            <ol class="ps-timeline">
              {timelineRows.map((row) => (
                <li>
                  <span class="ps-timeline__label">{timelineLabel(row.kind)}</span>
                  <time>{timelineTimestamp(row.at)}</time>
                </li>
              ))}
            </ol>
          </div>
        </div>
      </div>

    <script
      define:vars={{ t, issueId: issue.issueId, deliberationId: deliberation?.deliberationId ?? null }}
      type="module"
    >
      const supportForm = document.getElementById("support-form");
      if (supportForm) {
        const errorEl = document.getElementById("support-error");
        const successEl = document.getElementById("support-success");

        supportForm.addEventListener("submit", async (event) => {
          event.preventDefault();
          errorEl.hidden = true;
          successEl.hidden = true;

          const submitButton = supportForm.querySelector("button[type=submit]");
          submitButton.disabled = true;
          const originalLabel = submitButton.textContent;
          submitButton.textContent = t["issue.detail.support.submitting"];

          try {
            const data = new FormData(supportForm);
            const res = await fetch(`/api/issues/${issueId}/support`, {
              method: "POST",
              headers: { "Content-Type": "application/json" },
              body: JSON.stringify({ wardId: data.get("wardId") }),
            });

            if (res.status === 201) {
              successEl.hidden = false;
              submitButton.disabled = true;
              return;
            }

            const json = await res.json().catch(() => ({}));
            errorEl.textContent =
              t[`issue.detail.support.error.${json.error}`] ?? t["issue.detail.support.error.generic"];
            errorEl.hidden = false;
            submitButton.disabled = false;
          } catch {
            errorEl.textContent = t["issue.detail.support.error.generic"];
            errorEl.hidden = false;
            submitButton.disabled = false;
          } finally {
            submitButton.textContent = originalLabel;
          }
        });
      }

      // C1 — Statement Submission & Voting (issue #33). Vanilla JS, no
      // `client:` directive, matching the existing support/flag-form
      // convention. Only rendered for a signed-in T2 member (server-gated
      // above), so `deliberation-statement-card` only exists in the DOM
      // when there's a real deliberationId to call.
      const statementCard = document.getElementById("deliberation-statement-card");
      if (statementCard && deliberationId) {
        const bodyEl = document.getElementById("deliberation-statement-body");
        const positionEl = document.getElementById("deliberation-position");
        const emptyEl = document.getElementById("deliberation-empty");
        const voteErrorEl = document.getElementById("deliberation-vote-error");
        let currentStatementId = null;

        async function loadNextStatement() {
          voteErrorEl.hidden = true;
          const res = await fetch(`/api/deliberations/${deliberationId}/statements/next`);
          if (!res.ok) return;
          const json = await res.json();

          positionEl.textContent = t["issue.detail.deliberation.position"]
            .replace("{position}", json.position)
            .replace("{total}", json.total);

          if (json.done) {
            statementCard.hidden = true;
            emptyEl.hidden = false;
            currentStatementId = null;
            return;
          }
          emptyEl.hidden = true;
          statementCard.hidden = false;
          bodyEl.textContent = json.statement.body;
          currentStatementId = json.statement.statementId;
        }

        for (const button of statementCard.querySelectorAll(".ps-vote-btn")) {
          button.addEventListener("click", async () => {
            if (!currentStatementId) return;
            voteErrorEl.hidden = true;

            const res = await fetch(`/api/statements/${currentStatementId}/vote`, {
              method: "POST",
              headers: { "Content-Type": "application/json" },
              body: JSON.stringify({ vote: button.dataset.vote }),
            });

            if (res.status === 201) {
              await loadNextStatement();
              return;
            }
            const json = await res.json().catch(() => ({}));
            voteErrorEl.textContent =
              t[`issue.detail.deliberation.vote.error.${json.error}`] ??
              t["issue.detail.deliberation.vote.error.generic"];
            voteErrorEl.hidden = false;
          });
        }

        loadNextStatement();
      }

      const statementForm = document.getElementById("statement-form");
      if (statementForm && deliberationId) {
        const textarea = statementForm.querySelector("textarea[name=body]");
        const charCount = document.getElementById("statement-char-count");
        const errorEl = document.getElementById("statement-error");
        const successEl = document.getElementById("statement-success");

        textarea.addEventListener("input", () => {
          charCount.textContent = `${textarea.value.length} / 280`;
        });

        statementForm.addEventListener("submit", async (event) => {
          event.preventDefault();
          errorEl.hidden = true;
          successEl.hidden = true;

          const submitButton = statementForm.querySelector("button[type=submit]");
          submitButton.disabled = true;

          try {
            const res = await fetch(`/api/deliberations/${deliberationId}/statements`, {
              method: "POST",
              headers: { "Content-Type": "application/json" },
              body: JSON.stringify({ body: textarea.value }),
            });

            if (res.status === 201) {
              successEl.hidden = false;
              statementForm.reset();
              charCount.textContent = "0 / 280";
              return;
            }

            const json = await res.json().catch(() => ({}));
            errorEl.textContent =
              t[`issue.detail.deliberation.submit.error.${json.error}`] ??
              t["issue.detail.deliberation.submit.error.generic"];
            errorEl.hidden = false;
          } catch {
            errorEl.textContent = t["issue.detail.deliberation.submit.error.generic"];
            errorEl.hidden = false;
          } finally {
            submitButton.disabled = false;
          }
        });
      }

      const form = document.getElementById("flag-form");
      if (form) {
        const errorEl = document.getElementById("flag-error");
        const successEl = document.getElementById("flag-success");

        form.addEventListener("submit", async (event) => {
          event.preventDefault();
          errorEl.hidden = true;
          successEl.hidden = true;

          const submitButton = form.querySelector("button[type=submit]");
          submitButton.disabled = true;
          const originalLabel = submitButton.textContent;
          submitButton.textContent = t["issue.detail.flag.submitting"];

          try {
            const data = new FormData(form);
            const res = await fetch(`/api/issues/${issueId}/flag-routing`, {
              method: "POST",
              headers: { "Content-Type": "application/json" },
              body: JSON.stringify({ note: data.get("note") || undefined }),
            });

            if (res.status === 201) {
              successEl.hidden = false;
              form.reset();
              return;
            }

            const json = await res.json().catch(() => ({}));
            errorEl.textContent = t[`issue.detail.flag.error.${json.error}`] ?? t["issue.detail.flag.error.generic"];
            errorEl.hidden = false;
          } catch {
            errorEl.textContent = t["issue.detail.flag.error.generic"];
            errorEl.hidden = false;
          } finally {
            submitButton.disabled = false;
            submitButton.textContent = originalLabel;
          }
        });
      }
    </script>

    <style>
