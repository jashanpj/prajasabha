      }
      .ps-vote-btn--pass {
        border: 1.5px solid var(--color-disabled);
        color: var(--status-no-response-text);
      }
      .ps-deliberation-position {
        color: var(--color-muted);
        font-size: var(--font-size-caption);
      }
      .ps-char-count {
        color: var(--color-muted);
        font-size: var(--font-size-caption);
      }
      .ps-broad-agreement,
      .ps-all-statements {
        margin-top: 0.75em;
      }
      .ps-broad-agreement h3,
      .ps-all-statements h3 {
        font-size: var(--font-size-section-label);
        margin-bottom: 0.5em;
      }
      .ps-consensus-list {
        list-style: none;
        padding: 0;
        margin: 0;
        border: 1px solid var(--color-card-border);
        border-radius: var(--radius-card);
        background: #fff;
      }
      .ps-consensus-list li {
        display: flex;
        align-items: center;
        flex-wrap: wrap;
        gap: 0.9em;
        padding: 0.9em 1.2em;
        border-bottom: 1px solid var(--color-card-border);
      }
      .ps-consensus-list li:last-child {
        border-bottom: none;
      }
      .ps-consensus-body {
        flex: 1 1 220px;
        font-size: var(--font-size-body);
      }
      .ps-consensus-bar {
        width: 140px;
        height: 8px;
        border-radius: 4px;
        background: var(--progress-track);
        overflow: hidden;
        display: block;
        flex-shrink: 0;
      }
      .ps-consensus-bar__fill {
        display: block;
        height: 100%;
        background: var(--color-navy);
      }
      .ps-consensus-bar__fill--meets {
        background: var(--color-green);
      }
      .ps-consensus-percent {
        width: 70px;
        font-size: var(--font-size-body);
        font-weight: 700;
        color: var(--color-navy);
        text-align: right;
        flex-shrink: 0;
      }
      .ps-consensus-percent--meets {
        color: var(--status-acted-upon-text);
