---
import AuthorityChip from "../components/AuthorityChip.astro";
import Button from "../components/Button.astro";
import SiteChrome from "../components/SiteChrome.astro";
import "../styles/global.css";
import { schema } from "db";
import { and, desc, eq, inArray, sql } from "drizzle-orm";
import en from "../i18n/en.json";
import ml from "../i18n/ml.json";
import { getServiceRoleDb } from "../lib/db";

// Constituency dashboard (issue #90 — matches web/dashboard.dc.html's
// "Constituency concerns" list, sorted by support count). Public read,
// same visibility rule
// as issues/[slug].astro (status='published' — RLS's issues_public_read
// policy doesn't gate this service-role connection, so it's re-checked in
// application logic here too).
//
// Deliberately omitted vs. the mockup: "Active deliberations" (Module C)
// and "Latest from your MP" (Module F) — neither has any backing data
// model in this system yet, so they're left out rather than shown empty
// or faked. No StatusChip per issue either — that tracks authority-
// response state (Module F's tx_status_events), which no issue has ever
// had; see #93/#90's issue bodies for the full reasoning. (#113 tracks
// adding "Active deliberations" back for real, now that Module C exists.)
const locale = Astro.url.searchParams.get("lang") === "en" ? "en" : "ml";
const t: Record<string, string> = locale === "en" ? en : ml;

const env = import.meta.env.DEV ? undefined : (await import("cloudflare:workers")).env;
const appDatabaseUrl = import.meta.env.DEV
  ? "postgres://app_role:app_role_dev_only@localhost:5432/prajasabha_dev"
  : env?.APP_DATABASE_URL;
const db = getServiceRoleDb(appDatabaseUrl as string);

const numberFormat = new Intl.NumberFormat(locale === "en" ? "en-IN" : "ml-IN");

// #104 visual-polish: the mockup's header stat block ("Your constituency" /
// constituency name / verified-constituent count) needs no new backend
// query — same PILOT_CONSTITUENCY_NAME_* env vars SiteChrome already reads
// and the same tier='t2' count query index.astro already runs.
const pilotConstituencyName =
  locale === "en"
    ? import.meta.env.DEV
      ? "Pilot Constituency"
      : env?.PILOT_CONSTITUENCY_NAME_EN
    : import.meta.env.DEV
      ? "പൈലറ്റ് മണ്ഡലം"
      : env?.PILOT_CONSTITUENCY_NAME_ML;

let verifiedConstituents: number | null = null;
try {
  const [row] = await db
    .select({ verifiedConstituents: sql<number>`count(*)`.mapWith(Number) })
    .from(schema.members)
    .where(eq(schema.members.tier, "t2"));
  verifiedConstituents = row?.verifiedConstituents ?? null;
} catch {
  verifiedConstituents = null;
}

const TOP_ISSUES_LIMIT = 5;

const topIssues = await db
  .select({
    issueId: schema.issues.issueId,
    slug: schema.issues.slug,
    titleMl: schema.issues.titleMl,
    titleEn: schema.issues.titleEn,
    supportT2Count: schema.issues.supportT2Count,
  })
  .from(schema.issues)
  .where(eq(schema.issues.status, "published"))
  .orderBy(desc(schema.issues.supportT2Count))
  .limit(TOP_ISSUES_LIMIT);

const [{ publishedCount }] = await db
  .select({ publishedCount: sql<number>`count(*)`.mapWith(Number) })
  .from(schema.issues)
  .where(eq(schema.issues.status, "published"));

const responsibleAuthorityByIssue = new Map<string, { nameMl: string; nameEn: string }>();
if (topIssues.length > 0) {
  const routingRows = await db
    .select({
      issueId: schema.routings.issueId,
      authorityNameMl: schema.authorities.nameMl,
      authorityNameEn: schema.authorities.nameEn,
    })
    .from(schema.routings)
    .innerJoin(schema.authorities, eq(schema.routings.authorityId, schema.authorities.authorityId))
    .where(
      and(
        eq(schema.routings.role, "responsible"),
        inArray(
          schema.routings.issueId,
          topIssues.map((issue) => issue.issueId),
        ),
      ),
    );
  for (const row of routingRows) {
    if (!responsibleAuthorityByIssue.has(row.issueId)) {
      responsibleAuthorityByIssue.set(row.issueId, {
        nameMl: row.authorityNameMl,
        nameEn: row.authorityNameEn,
      });
    }
  }
}

function issueTitle(issue: (typeof topIssues)[number]): string {
  return locale === "en" ? issue.titleEn : issue.titleMl;
}
function authorityName(authority: { nameMl: string; nameEn: string }): string {
  return locale === "en" ? authority.nameEn : authority.nameMl;
}
---

<html lang={locale}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{t["dashboard.title"]}</title>
  </head>
  <body>
    <SiteChrome locale={locale}>
      <div class="ps-dashboard">
        <div class="ps-dashboard__header">
          <div>
            <p class="ps-dashboard__eyebrow">{t["dashboard.header.eyebrow"]}</p>
            <h1 class="ps-dashboard__constituency">{pilotConstituencyName}</h1>
            {verifiedConstituents !== null && (
              <p class="ps-dashboard__header-sub">
                {t["dashboard.header.verifiedCount"].replace(
                  "{count}",
                  numberFormat.format(verifiedConstituents),
                )}
              </p>
            )}
          </div>
          <Button href={`/issues/new?lang=${locale}`}>{t["dashboard.header.raiseIssue"]}</Button>
        </div>

        <a href={`/issues/new?lang=${locale}`} class="ps-router-banner">
          <span class="ps-router-banner__title">{t["dashboard.routerBanner.title"]}</span>
          <span class="ps-router-banner__body">{t["dashboard.routerBanner.body"]}</span>
        </a>

        <section class="ps-concerns">
          <div class="ps-concerns__heading">
            <h2>{t["dashboard.concerns.title"]}</h2>
            <span class="ps-concerns__rankedBy">{t["dashboard.concerns.rankedBy"]}</span>
          </div>
          {
            topIssues.length === 0 ? (
              <p>{t["dashboard.concerns.empty"]}</p>
            ) : (
              <ul class="ps-concerns__list">
                {topIssues.map((issue, index) => {
                  const authority = responsibleAuthorityByIssue.get(issue.issueId);
                  return (
                    <li>
                      <a href={`/issues/${issue.slug}?lang=${locale}`} class="ps-concerns__row">
                        <span class="ps-concerns__rank tabular-nums" aria-hidden="true">
                          {index + 1}
                        </span>
                        <span class="ps-concerns__body">
                          <span class="ps-concerns__title">{issueTitle(issue)}</span>
                          <span class="ps-concerns__meta">
                            <span class="ps-concerns__support tabular-nums">
                              {t["dashboard.concerns.supportCount"].replace(
                                "{count}",
                                numberFormat.format(issue.supportT2Count),
                              )}
                            </span>
                            {authority && (
                              <AuthorityChip
                                role="responsible"
                                authorityName={authorityName(authority)}
                                roleLabel={t["issue.routing.role.responsible"]}
                              />
                            )}
                          </span>
                        </span>
                        <span class="ps-concerns__arrow" aria-hidden="true">→</span>
                      </a>
                    </li>
                  );
                })}
              </ul>
            )
          }
          <p class="ps-concerns__total">
            {t["dashboard.concerns.total"].replace("{count}", numberFormat.format(publishedCount))}
          </p>
        </section>
      </div>
    </SiteChrome>
  </body>
</html>

<style>
  .ps-dashboard {
    padding: 1.5em;
    display: flex;
    flex-direction: column;
    gap: 1.25em;
  }
  .ps-dashboard__header {
    display: flex;
    justify-content: space-between;
    align-items: flex-end;
    gap: 1em;
    flex-wrap: wrap;
  }
  .ps-dashboard__eyebrow {
    font-size: var(--font-size-caption);
    font-weight: 700;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--color-muted);
    margin: 0;
  }
  .ps-dashboard__constituency {
    font-family: var(--font-family-heading);
    font-weight: var(--font-weight-heading);
    font-size: var(--font-size-display);
    color: var(--color-navy);
    margin: 0.1em 0 0;
  }
  .ps-dashboard__header-sub {
    color: var(--color-muted);
    font-size: var(--font-size-caption);
    margin: 0.2em 0 0;
  }
  .ps-router-banner {
    display: flex;
    flex-direction: column;
    gap: 0.2em;
    background: var(--color-card-fill);
    border: 1px solid var(--color-card-border);
    border-radius: var(--radius-card);
    padding: 1em 1.25em;
    text-decoration: none;
    color: inherit;
  }
  .ps-router-banner__title {
    font-weight: 600;
    color: var(--color-navy);
  }
  .ps-router-banner__body {
    color: var(--color-muted);
    font-size: var(--font-size-body);
  }
  .ps-concerns {
    display: flex;
    flex-direction: column;
    gap: 0.75em;
  }
  .ps-concerns__heading {
    display: flex;
    justify-content: space-between;
    align-items: baseline;
  }
  .ps-concerns__rankedBy {
    color: var(--color-muted);
    font-size: var(--font-size-caption);
  }
  .ps-concerns__list {
    list-style: none;
    padding: 0;
    margin: 0;
    border: 1px solid var(--color-card-border);
    border-radius: var(--radius-card);
    background: var(--color-card-fill);
    overflow: hidden;
  }
  .ps-concerns__row {
    display: flex;
    align-items: center;
    gap: 0.9em;
    padding: 1em 1.25em;
    border-bottom: 1px solid var(--color-card-border);
    text-decoration: none;
    color: inherit;
  }
  .ps-concerns__list li:last-child .ps-concerns__row {
    border-bottom: none;
  }
  .ps-concerns__rank {
    font-family: var(--font-family-heading);
    font-weight: var(--font-weight-heading);
    font-size: var(--font-size-heading);
    color: var(--color-disabled);
    flex-shrink: 0;
  }
  .ps-concerns__body {
    flex: 1;
    display: flex;
    flex-direction: column;
    gap: 0.4em;
    min-width: 0;
  }
  .ps-concerns__title {
    font-weight: 600;
    font-size: var(--font-size-body);
    color: var(--color-charcoal);
  }
  .ps-concerns__meta {
    display: flex;
    align-items: center;
    gap: 0.75em;
    flex-wrap: wrap;
  }
  .ps-concerns__support {
    color: var(--color-green);
    font-weight: 600;
    font-size: var(--font-size-caption);
  }
  .ps-concerns__arrow {
    color: var(--color-disabled);
    flex-shrink: 0;
  }
  .ps-concerns__total {
    color: var(--color-muted);
    font-size: var(--font-size-caption);
    margin: 0;
  }
</style>
