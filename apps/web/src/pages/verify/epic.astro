---
import Button from "../../components/Button.astro";
import SiteChrome from "../../components/SiteChrome.astro";
import "../../styles/global.css";
import { verifySession } from "shared";
import en from "../../i18n/en.json";
import ml from "../../i18n/ml.json";

// A3 — EPIC verification submission (issue #22). Plain HTML form, zero
// Astro island (progressive-enhancement vanilla JS only), same posture as
// register.astro. The client-side script below does the HLD §4.3-faithful
// two-step submit: first POSTs the raw EPIC number + doc straight to
// vault-svc's public endpoint (never through this app's own server), then
// POSTs only {memberId, docRef} to this app's own /api/verify/epic/submit.
const locale = Astro.url.searchParams.get("lang") === "en" ? "en" : "ml";
const t = locale === "en" ? en : ml;

const sessionCookie = Astro.cookies.get("ps_session")?.value;
const env = import.meta.env.DEV ? undefined : (await import("cloudflare:workers")).env;
const sessionSecret = import.meta.env.DEV
  ? "local-dev-session-secret-do-not-use-in-prod"
  : env?.SESSION_SECRET;
const session =
  sessionCookie && sessionSecret ? await verifySession(sessionCookie, sessionSecret) : null;

if (!session) {
  return Astro.redirect("/register");
}

const TURNSTILE_DEV_TEST_SITE_KEY = `1x${"0".repeat(22)}AA`;
const siteKey = import.meta.env.DEV ? TURNSTILE_DEV_TEST_SITE_KEY : env?.TURNSTILE_SITE_KEY;
const vaultSvcPublicUrl = import.meta.env.DEV ? "http://localhost:8789" : env?.PUBLIC_VAULT_SVC_URL;
const memberId = session.memberId;
---

<html lang={locale}>
  <head>
    <meta charset="utf-8" />
    <title>{t["epic.title"]}</title>
    <script src="https://challenges.cloudflare.com/turnstile/v0/api.js" async defer></script>
  </head>
  <body>
    <SiteChrome locale={locale}>
      <div class="ps-card ps-form">
        <h1>{t["epic.title"]}</h1>

        <form id="epic-form">
          <label>
            {t["epic.epicNumber.label"]}
            <input type="text" name="epicNumber" required />
          </label>
          <p class="ps-form-hint">{t["epic.epicNumber.hint"]}</p>
          <label>
            {t["epic.assemblySegment.label"]}
            <input type="text" name="assemblySegmentClaimed" required />
          </label>
          <label>
            {t["epic.doc.label"]}
            <input type="file" name="doc" accept="image/*,application/pdf" required />
          </label>
          <div class="cf-turnstile" data-sitekey={siteKey}></div>
          <p id="epic-error" class="ps-form-error" role="alert" hidden></p>
          <Button type="submit">{t["epic.submit"]}</Button>
        </form>
      </div>

    <script
      define:vars={{ errors: t, memberId, vaultSvcPublicUrl }}
      type="module"
    >
      const form = document.getElementById("epic-form");
      const errorEl = document.getElementById("epic-error");

      function fileToBase64(file) {
        return new Promise((resolve, reject) => {
          const reader = new FileReader();
          reader.onload = () => resolve(String(reader.result).split(",")[1] ?? "");
          reader.onerror = reject;
          reader.readAsDataURL(file);
        });
      }

      form.addEventListener("submit", async (event) => {
        event.preventDefault();
        errorEl.hidden = true;

        const data = new FormData(form);
        const docFile = data.get("doc");
        const submitButton = form.querySelector("button[type=submit]");
        submitButton.disabled = true;

        try {
          const docBase64 = await fileToBase64(docFile);

          // Step 1: raw EPIC number + doc go straight to vault-svc, never
          // through this app's own server (HLD §4.3's "separate origin").
          const submitRes = await fetch(`${vaultSvcPublicUrl}/public/epic/submit`, {
            method: "POST",
            headers: { "Content-Type": "application/json" },
            body: JSON.stringify({
              epicNumber: data.get("epicNumber"),
              docBase64,
              assemblySegmentClaimed: data.get("assemblySegmentClaimed"),
              turnstileToken: data.get("cf-turnstile-response"),
            }),
          });

          if (!submitRes.ok) {
            const json = await submitRes.json().catch(() => ({}));
            const message = errors[`epic.error.${json.error}`] ?? errors["epic.error.generic"];
            errorEl.textContent = message;
            errorEl.hidden = false;
            return;
          }

          const { docRef } = await submitRes.json();

          // Step 2: only {memberId, docRef} reaches this app's own server.
          const linkRes = await fetch("/api/verify/epic/submit", {
            method: "POST",
            headers: { "Content-Type": "application/json" },
            body: JSON.stringify({ memberId, docRef }),
          });

          if (linkRes.status === 202) {
            window.location.assign(`/verify/epic/status?lang=${document.documentElement.lang}`);
            return;
          }

          const json = await linkRes.json().catch(() => ({}));
          const message = errors[`epic.error.${json.error}`] ?? errors["epic.error.generic"];
          errorEl.textContent = message;
          errorEl.hidden = false;
        } catch {
          errorEl.textContent = errors["epic.error.generic"];
          errorEl.hidden = false;
        } finally {
          submitButton.disabled = false;
        }
      });
    </script>
    </SiteChrome>
  </body>
</html>
