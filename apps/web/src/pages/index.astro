---
import { APP_NAME } from "shared";
import ml from "../i18n/ml.json";

// Locale routing/detection is a later story — this scaffold just proves
// the i18n file pair and the workspace import resolve for real, rendering
// Malayalam (the default locale per CLAUDE.md) directly.
const tagline = ml["home.tagline"];
---

<html lang="ml">
  <head>
    <meta charset="utf-8" />
    <title>{APP_NAME}</title>
  </head>
  <body>
    <h1>{APP_NAME}</h1>
    <p>{tagline}</p>
  </body>
</html>
