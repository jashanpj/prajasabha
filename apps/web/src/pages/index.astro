---
import { APP_NAME, verifySession } from "shared";
import Button from "../components/Button.astro";
import SiteChrome from "../components/SiteChrome.astro";
import "../styles/global.css";
import { schema } from "db";
import { eq, sql } from "drizzle-orm";
import en from "../i18n/en.json";
import ml from "../i18n/ml.json";
import { getServiceRoleDb } from "../lib/db";

// Home landing page (issue #89 — redesign to match web/home.dc.html from
// the design package). Session-aware call-to-action, three states —
// mirrors the DEV-fallback session/DB pattern already established in
// pages/issues/[slug].astro and pages/verify/epic.astro, no new pattern
// introduced. T1/Aadhaar is postponed (todo.md) — EPIC verification is the
// only path from T0 to full participation and flips tier straight to 't2'
// (apps/web/src/pages/api/verify/epic/status.ts) — so "not yet t2" is
// the only intermediate state worth branching on here.
const locale = Astro.url.searchParams.get("lang") === "en" ? "en" : "ml";
const t: Record<string, string> = locale === "en" ? en : ml;

const sessionCookieValue = Astro.cookies.get("ps_session")?.value;
const env = import.meta.env.DEV ? undefined : (await import("cloudflare:workers")).env;
const sessionSecret = import.meta.env.DEV
  ? "local-dev-session-secret-do-not-use-in-prod"
  : env?.SESSION_SECRET;
const session =
  sessionCookieValue && sessionSecret
    ? await verifySession(sessionCookieValue, sessionSecret)
    : null;

const appDatabaseUrl = import.meta.env.DEV
  ? "postgres://app_role:app_role_dev_only@localhost:5432/prajasabha_dev"
  : env?.APP_DATABASE_URL;
const db = getServiceRoleDb(appDatabaseUrl as string);

let tier: "t0" | "t1" | "t2" | null = null;
if (session) {
  const [member] = await db
    .select({ tier: schema.members.tier })
    .from(schema.members)
    .where(eq(schema.members.memberId, session.memberId))
    .limit(1);
  tier = member?.tier ?? null;
}

const cta = !session
  ? {
      href: `/register?lang=${locale}`,
      label: t["home.cta.register"],
      body: t["home.cta.register.body"],
    }
  : tier === "t2"
    ? { href: "/issues/new", label: t["home.cta.raiseIssue"], body: t["home.cta.raiseIssue.body"] }
    : {
        href: "/verify/epic",
        label: t["home.cta.verifyEpic"],
        body: t["home.cta.verifyEpic.body"],
      };

// Stat counter: only what's real today (verified/T2 member count). The
// mockup also shows "issues acted upon" and "bills transmitted" counters —
// those track Module F/K data (accountability ledger, model bills) that
// doesn't exist in this system yet, so they're omitted rather than shown
// as fabricated zeros (see the redesign plan's Context on this).
const [{ verifiedConstituents }] = await db
  .select({ verifiedConstituents: sql<number>`count(*)`.mapWith(Number) })
  .from(schema.members)
  .where(eq(schema.members.tier, "t2"));
---

<html lang={locale}>
  <head>
    <meta charset="utf-8" />
    <title>{APP_NAME}</title>
  </head>
  <body>
    <SiteChrome locale={locale}>
      <section class="ps-hero">
        <div class="ps-hero__copy">
          <h1>{t["home.tagline"]}</h1>
          <p class="ps-hero__subcopy">{t["home.hero.subcopy"]}</p>
          <div class="ps-hero__ctas">
            <Button href={cta.href}>{cta.label}</Button>
            <Button href="#how-it-works" variant="secondary">
              {t["home.hero.seeHowItWorks"]}
            </Button>
          </div>
          <p class="ps-hero__stat tabular-nums">
            {t["home.stats.verifiedConstituents"].replace("{count}", `${verifiedConstituents}`)}
          </p>
        </div>
        <div class="ps-hero__features">
          <div class="ps-card">
            <div class="ps-card__header">
              <svg
                class="ps-card__icon"
                viewBox="0 0 24 24"
                width="20"
                height="20"
                aria-hidden="true"
              >
                <circle
                  cx="12"
                  cy="12"
                  r="9"
                  fill="none"
                  stroke="var(--color-navy)"
                  stroke-width="1.5"
                />
                <circle cx="12" cy="12" r="2.5" fill="var(--color-navy)" />
              </svg>
              <h2>{t["home.features.neutral.title"]}</h2>
            </div>
            <p>{t["home.features.neutral.body"]}</p>
          </div>
          <div class="ps-card">
            <div class="ps-card__header">
              <svg
                class="ps-card__icon"
                viewBox="0 0 24 24"
                width="20"
                height="20"
                aria-hidden="true"
              >
                <circle
                  cx="12"
                  cy="12"
                  r="9"
                  fill="none"
                  stroke="var(--color-green)"
                  stroke-width="1.5"
                />
                <path
                  d="M8 12.5l2.5 2.5 5-5.5"
                  fill="none"
                  stroke="var(--color-green)"
                  stroke-width="1.5"
                  stroke-linecap="round"
                  stroke-linejoin="round"
                />
              </svg>
              <h2>{t["home.features.oneVoice.title"]}</h2>
            </div>
            <p>{t["home.features.oneVoice.body"]}</p>
          </div>
          <div class="ps-card">
            <div class="ps-card__header">
              <svg
                class="ps-card__icon"
                viewBox="0 0 24 24"
                width="20"
                height="20"
                aria-hidden="true"
              >
                <rect
                  x="5"
                  y="3"
                  width="14"
                  height="18"
                  rx="1.5"
                  fill="none"
                  stroke="var(--color-saffron)"
                  stroke-width="1.5"
                />
                <line x1="8" y1="8" x2="16" y2="8" stroke="var(--color-saffron)" stroke-width="1.5" />
                <line x1="8" y1="12" x2="16" y2="12" stroke="var(--color-saffron)" stroke-width="1.5" />
                <line x1="8" y1="16" x2="13" y2="16" stroke="var(--color-saffron)" stroke-width="1.5" />
              </svg>
              <h2>{t["home.features.record.title"]}</h2>
            </div>
            <p>{t["home.features.record.body"]}</p>
          </div>
        </div>
      </section>

      <section id="how-it-works" class="ps-how">
        <h2>{t["home.howItWorks.title"]}</h2>
        <ol class="ps-how__steps">
          <li>
            <a href={`/register?lang=${locale}`}>
              <span class="ps-how__step-number">1</span>
              <h3>{t["home.howItWorks.step1.title"]}</h3>
            </a>
            <p>{t["home.howItWorks.step1.body"]}</p>
          </li>
          <li>
            <a href={`/issues/new?lang=${locale}`}>
              <span class="ps-how__step-number">2</span>
              <h3>{t["home.howItWorks.step2.title"]}</h3>
            </a>
            <p>{t["home.howItWorks.step2.body"]}</p>
          </li>
          <li>
            <div class="ps-how__step-header">
              <span class="ps-how__step-number">3</span>
              <h3>{t["home.howItWorks.step3.title"]}</h3>
            </div>
            <p>{t["home.howItWorks.step3.body"]}</p>
          </li>
        </ol>
      </section>
    </SiteChrome>
  </body>
</html>

<style>
  .ps-hero {
    display: grid;
    grid-template-columns: 1.2fr 1fr;
    gap: 2em;
    padding: 2.5em 1.5em;
    background: var(--color-ivory);
  }
  .ps-hero__copy h1 {
    font-family: var(--font-family-heading);
    font-weight: var(--font-weight-heading);
    font-size: var(--font-size-display);
    color: var(--color-charcoal);
    margin: 0 0 0.5em;
  }
  .ps-hero__subcopy {
    color: var(--color-muted);
    line-height: var(--line-height-body);
  }
  .ps-hero__ctas {
    display: flex;
    gap: 1em;
    margin: 1em 0;
  }
  .ps-hero__stat {
    color: var(--color-navy);
    font-weight: 600;
  }
  .ps-hero__features {
    display: flex;
    flex-direction: column;
    gap: 1em;
  }
  .ps-card {
    background: var(--color-card-fill);
    border: 1px solid var(--color-card-border);
    border-radius: var(--radius-card);
    padding: 1em 1.25em;
  }
  .ps-card__header {
    display: flex;
    align-items: center;
    gap: 0.6em;
    margin: 0 0 0.3em;
  }
  .ps-card__icon {
    flex-shrink: 0;
  }
  .ps-card h2 {
    font-size: var(--font-size-heading);
    margin: 0;
  }
  .ps-card p {
    color: var(--color-muted);
    font-size: var(--font-size-body);
    margin: 0;
  }
  .ps-how {
    background: #f2f0e9;
    padding: 2.5em 1.5em;
  }
  .ps-how__steps {
    list-style: none;
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 1.5em;
    padding: 0;
  }
  .ps-how__steps a,
  .ps-how__step-header {
    display: flex;
    align-items: center;
    gap: 0.6em;
    text-decoration: none;
    color: var(--color-navy);
  }
  .ps-how__steps li {
    display: flex;
    flex-direction: column;
    gap: 0.3em;
  }
  .ps-how__steps h3 {
    font-size: var(--font-size-heading);
    margin: 0;
    color: var(--color-charcoal);
  }
  .ps-how__step-number {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 1.6em;
    height: 1.6em;
    border-radius: 50%;
    background: var(--color-navy);
    color: var(--color-ivory);
    font-weight: 700;
    flex-shrink: 0;
  }
  .ps-how__steps p {
    color: var(--color-muted);
    margin: 0;
  }
</style>
