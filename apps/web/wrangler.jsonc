{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "prajasabha-web",
  "compatibility_date": "2025-01-01",
  "compatibility_flags": ["nodejs_compat"],
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS"
  },
  // Issue #20 — A1 registration. RATE_LIMIT_KV needs a real namespace id
  // per environment (`wrangler kv namespace create RATE_LIMIT_KV`) before
  // deploying — "local-dev-placeholder" only works for `wrangler dev`'s
  // local KV emulation. VAULT_SVC is a service binding to apps/vault-svc —
  // the only way this Worker reaches the identity vault, never a direct
  // packages/vault-db import (CLAUDE.md invariant 2).
  "kv_namespaces": [{ "binding": "RATE_LIMIT_KV", "id": "local-dev-placeholder" }],
  // Issue #35 — C3's demo-only manual sweep trigger
  // (POST /api/admin/deliberations/sweep) calls apps/jobs over this
  // binding, same cross-Worker pattern as VAULT_SVC above.
  "services": [
    { "binding": "VAULT_SVC", "service": "prajasabha-vault-svc" },
    { "binding": "JOBS_SVC", "service": "prajasabha-jobs" }
  ],
  // Issue #24 — B1 evidence photos. EXIF/GPS-stripped bytes only (the
  // photos endpoint strips before put); keys are indexed in
  // issues.photo_keys. Needs a real bucket per environment
  // (`wrangler r2 bucket create prajasabha-issue-photos`) before deploying
  // — local `wrangler dev` emulates it.
  "r2_buckets": [{ "binding": "ISSUE_PHOTOS", "bucket_name": "prajasabha-issue-photos" }]
  // Secrets (never committed — set via `wrangler secret put <NAME>` per
  // environment, or a gitignored .env/.dev.vars locally): APP_DATABASE_URL,
  // VAULT_SVC_INTERNAL_TOKEN, RESEND_API_KEY, TURNSTILE_SECRET_KEY,
  // TURNSTILE_SITE_KEY, SESSION_SECRET, MAGIC_LINK_TTL_MINUTES,
  // REGISTER_RATE_LIMIT_PER_EMAIL_PER_HOUR, REGISTER_RATE_LIMIT_PER_IP_PER_HOUR,
  // VERIFY_RATE_LIMIT_PER_IP_PER_HOUR, PILOT_CONSTITUENCY_NAME_ML,
  // PILOT_CONSTITUENCY_NAME_EN, COVERED_ASSEMBLY_SEGMENTS,
  // EPIC_LINK_RATE_LIMIT_PER_MEMBER_PER_HOUR, PUBLIC_VAULT_SVC_URL (issue #22),
  // ISSUE_CATEGORIES, PILOT_WARD_IDS, PILOT_WARD_NAMES_ML,
  // PILOT_WARD_NAMES_EN, ISSUE_CREATE_RATE_LIMIT_PER_MEMBER_PER_HOUR,
  // ISSUE_DRAFT_RATE_LIMIT_PER_MEMBER_PER_HOUR,
  // ISSUE_PHOTO_RATE_LIMIT_PER_MEMBER_PER_HOUR,
  // ISSUE_PUBLISH_RATE_LIMIT_PER_MEMBER_PER_HOUR (issue #24),
  // FLAG_ROUTING_RATE_LIMIT_PER_MEMBER_PER_HOUR (issue #25),
  // ISSUE_SUPPORT_RATE_LIMIT_PER_MEMBER_PER_HOUR, ISSUE_MERGE_ADMIN_TOKEN,
  // ISSUE_MERGE_ADMIN_IP_ALLOWLIST (issue #26),
  // DELIBERATION_OPEN_DAYS, DELIBERATION_SWEEP_ADMIN_TOKEN,
  // DELIBERATION_SWEEP_ADMIN_IP_ALLOWLIST, JOBS_INTERNAL_TOKEN
  // (issue #35) — see .env.example.
}
