{
  "name": "jobs",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "wrangler dev",
    "build": "wrangler deploy --dry-run --outdir dist",
    "test": "vitest run",
    "deploy:dev": "CLOUDFLARE_ENV= wrangler deploy",
