    "deploy:production": "wrangler deploy --env production"
  },
  "dependencies": {
    "db": "workspace:*",
    "drizzle-orm": "^0.45.2",
    "pg": "^8.22.0",
    "shared": "workspace:*"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20260724.1",
    "@types/pg": "^8.20.0",
    "typescript": "^5.7.2",
    "vitest": "^4.1.10",
    "wrangler": "^4.114.0"
  }
}
